# --- data feed ---
GEYSER_URL=https://your-yellowstone-grpc-endpoint:443
X_TOKEN=optional-grpc-token

# --- who to snipe ---
# Comma-separated creator wallets to watch for pump.fun coin creation.
WATCHED_CREATORS=CreatorPubkey1,CreatorPubkey2
BLACKLISTED_CREATORS=

# --- buyer wallets ---
# For 30 wallets use a directory of solana-keygen JSON files (sorted by name):
BUYER_KEYPAIR_DIR=/root/carbon/wallets
# ...or inline base58 secret keys, comma/newline separated:
# BUYER_KEYPAIRS=base58secret1,base58secret2
BUY_AMOUNT_SOL=0.01
SLIPPAGE_BPS=500
# Leave false for snipes: skips the user_volume_accumulator write, leaner tx.
TRACK_VOLUME=false
# Lamports each wallet must hold beyond its buy (fees + ATA rent + first-buy
# rents). Checked for every wallet at startup; underfunded wallets abort the run.
FUNDING_BUFFER_SOL=0.01

# --- guards ---
MIN_CREATOR_BALANCE_SOL=0
MAX_CREATOR_BUY_SOL=5
MAX_POSITIONS=5
MAX_TX_AGE_MS=3000

# --- sending ---
# simulate = dry run (default). Anything else goes live.
SEND_MODE=simulate
# Any combination of: rpc (spray across RPC_URLS), fast (FAST_PROVIDERS below),
# tpu (milestone 2, not implemented), jito (bundles of 5).
SEND_PATHS=rpc,fast
# Multiple RPC providers: every tx goes to all of them. A signature can land at
# most once, so duplicating across providers is free and takes the fastest route.
RPC_URLS=https://your-primary-rpc,https://your-secondary-rpc
COMPUTE_UNIT_LIMIT=120000
PRIORITY_FEE_MICRO_LAMPORTS=1000000
# Spread across wallets: wallet i pays base + jitter*i/(n-1), so the 30 buys sit
# at different priority levels instead of tying at one price.
PRIORITY_FEE_JITTER=500000

# --- fast / anti-MEV landing providers ---
# One entry per line (or ';' separated):
#   name|url|tip_account[+more]|tip_sol[|auth_header[|format]]
# format: jsonrpc (default) | transaction ({"transaction": "<base64>"}) |
#         raw (bare base64 body as text/plain — Nozomi needs this).
# VERIFY tip accounts, minimum tips, and body format against each provider's own
# docs before going live — a wrong tip account or body silently loses the tx.
# Wallets are dealt round-robin across these providers; each wallet's tip is
# baked into its transaction at build time.
# See PROVIDERS.md for endpoints, minimums and rate limits.
# Helius Sender routes to Jito internally and accepts Jito's tip accounts.
FAST_PROVIDERS=helius-fra|https://fra-sender.helius-rpc.com/fast|96gYZGLnJYVFmbjzopPSU6QiEV5fGqZNyN9nmNhvrZU5+HFqU5x63VTqvQss8hp11i4wVV8bD44PvwucfZ2bU7gRe|0.001
#
# Nozomi (Temporal) — the format field MUST be 'raw': its sendTransaction2 takes
# a bare base64 body as text/plain, NOT JSON-RPC. API key goes in the URL as ?c=.
# Min tip 0.001 SOL (1_000_000 lamports). All 17 tip accounts listed so the 30
# wallets spread across them (their docs warn about write-CU exhaustion).
# nozomi-fra|https://fra.nozomi.temporal.xyz/api/sendTransaction2?c=YOUR_API_KEY||0.001||raw
#
# Lunar Lander — confirm tip account and body format from their docs; if /send
# takes {"transaction": "<base64>"} append '|transaction', if bare base64 use '|raw'.
# lunar-fra|http://fra.lunar-lander.hellomoon.io/send|LUNAR_TIP_ACCOUNT_HERE|0.001||transaction
#
# Jito direct single-tx. Auth (if any) goes in the URL as ?uuid=<key>.
# Watch the 1 req/s/IP/region limit — only worth a couple of wallets.
# jito-fra|https://frankfurt.mainnet.block-engine.jito.wtf/api/v1/transactions?bundleOnly=true|96gYZGLnJYVFmbjzopPSU6QiEV5fGqZNyN9nmNhvrZU5|0.001

# --- jito bundles (optional parallel path, only used if SEND_PATHS has 'jito') ---
# Jito allows only 1 request/second per IP PER REGION, so bundles are dealt
# round-robin across these endpoints (30 buys = 6 bundles = 6 regions).
# Order nearest-first: from FSN1 that means Frankfurt, then Amsterdam/London.
JITO_BLOCK_ENGINE_URLS=https://frankfurt.mainnet.block-engine.jito.wtf,https://amsterdam.mainnet.block-engine.jito.wtf,https://london.mainnet.block-engine.jito.wtf,https://dublin.mainnet.block-engine.jito.wtf,https://ny.mainnet.block-engine.jito.wtf,https://slc.mainnet.block-engine.jito.wtf
# Protocol minimum is 1000 lamports, but on a contested launch the tip IS the bid.
JITO_TIP_SOL=0.001

# --- tpu direct (milestone 2) ---
TPU_LEADERS_AHEAD=2
