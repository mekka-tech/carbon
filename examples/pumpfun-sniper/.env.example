# --- data feed ---
GEYSER_URL=https://your-yellowstone-grpc-endpoint:443
X_TOKEN=optional-grpc-token
RPC_URL=https://your-rpc-endpoint

# --- who to snipe ---
# Comma-separated creator wallets to watch for pump.fun coin creation.
WATCHED_CREATORS=CreatorPubkey1,CreatorPubkey2
BLACKLISTED_CREATORS=

# --- buyers ---
# Comma-separated keypairs: base58-encoded 64-byte secrets or JSON byte arrays.
BUYER_KEYPAIRS=base58secret1,base58secret2
BUY_AMOUNT_SOL=0.01
SLIPPAGE_BPS=500
TRACK_VOLUME=false

# --- guards (mirrors the legacy bot) ---
MIN_CREATOR_BALANCE_SOL=0
MAX_CREATOR_BUY_SOL=5
MAX_POSITIONS=5
MAX_TX_AGE_MS=3000

# --- sending ---
# simulate (default, dry-run) | rpc (spray sendTransaction) | jito (atomic bundle)
SEND_MODE=simulate
COMPUTE_UNIT_LIMIT=120000
PRIORITY_FEE_MICRO_LAMPORTS=100000
JITO_BLOCK_ENGINE_URL=https://mainnet.block-engine.jito.wtf
JITO_TIP_SOL=0.0001
